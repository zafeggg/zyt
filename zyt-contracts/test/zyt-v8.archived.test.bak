  describe("v7 当日快照基准价（防价格操纵）", function () {
    it("初始化即锁定初始快照价，入金不改变当日计价价", async function () {
      const { pool, usdt, mining, alice } = await deployFixture();
      const initPrice = await pool.getTradePrice();
      // 初始 0.00001 U/ZYT：21000e18 / 21e9e18 × 1e18 = 1e13
      expect(initPrice).to.equal(ethers.parseEther("0.00001"));
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // 实时价因入金上涨，但快照锁定价当日恒定
      expect(await pool.getPrice()).to.be.gt(initPrice);
      expect(await pool.getTradePrice()).to.equal(initPrice);
    });

    it("快照后计价价锁定为快照瞬间实时价（通缩不影响当日计价）", async function () {
      const { pool, deflation, usdt, mining, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      const beforePrice = await pool.getPrice(); // 快照前实时价（含入金影响）
      await deflation.dailySnapshot(0);          // 快照锁定 + 通缩 2%
      // 锁定价 = 快照瞬间价；实时价因通缩(池 ZYT -2%)而高于锁定价
      expect(await pool.getTradePrice()).to.equal(beforePrice);
      expect(await pool.getPrice()).to.be.gt(beforePrice);
    });
  });

  describe("v7 链上卖出统计（UserSellInfo + userList）", function () {
    it("卖出后统计更新：次数/累计 ZYT/累计 USDT", async function () {
      const { zyt, mining, usdt, pool, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60")); // 兑换得 ZYT
      const zytBal = await zyt.balanceOf(alice.address);
      expect(zytBal).to.be.gt(0n);
      await zyt.connect(alice).approve(await pool.getAddress(), ethers.MaxUint256);
      await mining.connect(alice).sellZyt(zytBal / 2n);
      const info = await zyt.getSellInfo(alice.address);
      expect(info[0]).to.equal(1n);          // sellCount
      expect(info[1]).to.equal(zytBal / 2n); // totalSellZyt
      expect(info[2]).to.be.gt(0n);          // totalSellUsdt
      expect(info[4]).to.be.gt(0n);          // lastSellAt
    });

    it("userList 去重登记 + 遍历接口可用", async function () {
      const { zyt, mining, usdt, pool, alice, bob, deployer, creator, router, lpToken } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60"));
      await fundUsdt(usdt, bob, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(bob).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(bob).convertPowerToZyt(ethers.parseEther("60"));
      // 兑换 mint 即入列表：alice、bob（P2-2 白名单保护：技术 10% 收款方 technicalAddress=deployer 已白名单豁免，不列入用户统计）
      // 兑换 mint 即入列表：alice、bob（Router 与 Creator 均已白名单豁免，不列入用户统计）
      expect(await zyt.getUserCount()).to.equal(2n);
      const list = [];
      for (let i = 0; i < 2; i++) list.push((await zyt.getUserAt(i)).toLowerCase());
      expect(list).to.include(alice.address.toLowerCase());
      expect(list).to.include(bob.address.toLowerCase());
      // 同用户多次入金不重复入列
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      expect(await zyt.getUserCount()).to.equal(2n);
    });
  });

  describe("安全修复 V1/V2（审计第一批）", function () {
    it("V1：真实卖出（sellZyt 到池）计入 forceSell.soldAmount", async function () {
      const { mining, usdt, zyt, pool, forceSell, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60")); // 兑换得 ZYT
      const zytOfAlice = await zyt.balanceOf(alice.address);
      expect(zytOfAlice).to.be.gt(0n);
      // 卖出前 soldAmount = 0
      expect(await forceSell.soldAmount(alice.address)).to.equal(0n);
      // 卖出 1/10 到池（真实卖出路径）
      await zyt.connect(alice).approve(await pool.getAddress(), ethers.MaxUint256);
      await mining.connect(alice).sellZyt(zytOfAlice / 10n);
      // 修复后：卖出量计入 soldAmount（转账视同卖出）
      expect(await forceSell.soldAmount(alice.address)).to.equal(zytOfAlice / 10n);
    });

    it("V1：卖出到池不影响池的卖出检查（池收币无强制卖出义务）", async function () {
      const { mining, usdt, zyt, pool, forceSell, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60")); // 兑换得 ZYT
      const zytOfAlice = await zyt.balanceOf(alice.address);
      expect(zytOfAlice).to.be.gt(0n);
      await zyt.connect(alice).approve(await pool.getAddress(), ethers.MaxUint256);
      await mining.connect(alice).sellZyt(zytOfAlice / 10n);
      // 池被 checkAndBurn 初始化（记录 firstReceiveTime）属无害行为：
      // 池作为 from 转出时被 isWhiteList 跳过（永不触发检查），也不入 userList
      expect(await forceSell.initialized(await pool.getAddress())).to.equal(true);
      // 关键：池转出 ZYT（如 payoutDividend）不触发销毁检查
      const poolBal = await zyt.balanceOf(await pool.getAddress());
      expect(poolBal).to.be.gt(0n);
    });

    it("claimDividend：按日结算，无阶段门控（阶段 1 亦可提取）", async function () {
      const { mining, pool, deflation, usdt, zyt, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // 当日快照：产生 1% 分红并登记为该日的独立分红池
      await deflation.dailySnapshot(ethers.parseEther("100"));
      const day = BigInt(Math.floor((await ethers.provider.getBlock("latest")).timestamp / 86400));
      expect((await mining.dailyInfo(day))[2]).to.be.gt(0n); // dividendAmount
      expect(await pool.dividendPool()).to.be.gt(0n);
      // 该日尚未结束，当日不可结算
      await expect(mining.connect(alice).claimDividend()).to.be.revertedWith("Mining: nothing to claim");

      // 次日：alice 为全网唯一算力，独享该日全额分红
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      const zytBefore = await zyt.balanceOf(alice.address);
      await mining.connect(alice).claimDividend();
      const got = (await zyt.balanceOf(alice.address)) - zytBefore;
      expect(got).to.equal((await mining.dailyInfo(day))[2]);
      // 提取后待提余额清零、游标推进
      expect((await mining.dividendOf(alice.address))[0]).to.equal(0n);
    });

    it("分红按日隔离：晚入金者不参与其入金前的日分红", async function () {
      const { mining, deflation, usdt, zyt, alice, bob } = await deployFixture();
      // 第 1 天：alice 独享全网算力
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await deflation.dailySnapshot(ethers.parseEther("100"));
      const day1 = BigInt(Math.floor((await ethers.provider.getBlock("latest")).timestamp / 86400));

      // 第 2 天：bob 入金；alice 算力复利到 101，全网 201
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      await fundUsdt(usdt, bob, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(bob).deposit(ethers.parseEther("100"), ZERO);
      await deflation.dailySnapshot(ethers.parseEther("201"));
      const day2 = BigInt(Math.floor((await ethers.provider.getBlock("latest")).timestamp / 86400));

      // 第 3 天：两人各自提取
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      const div1 = (await mining.dailyInfo(day1))[2];
      const div2 = (await mining.dailyInfo(day2))[2];
      expect(div1).to.be.gt(0n);
      expect(div2).to.be.gt(0n);

      const aBefore = await zyt.balanceOf(alice.address);
      await mining.connect(alice).claimDividend();
      const aGot = (await zyt.balanceOf(alice.address)) - aBefore;

      const bBefore = await zyt.balanceOf(bob.address);
      await mining.connect(bob).claimDividend();
      const bGot = (await zyt.balanceOf(bob.address)) - bBefore;

      // alice：第 1 天全额 + 第 2 天 101/201；bob：仅第 2 天 100/201
      expect(aGot).to.equal(div1 + (div2 * 101n) / 201n);
      expect(bGot).to.equal((div2 * 100n) / 201n);
      // 核心：bob 分不到第 1 天的分红（累计池口径下会分走约一半）
      expect(bGot).to.be.lt(div1);
    });

    it("出局后仍可提取出局前的历史分红（exitDay 保留历史算力）", async function () {
      const { mining, deflation, usdt, zyt, config, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("300"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await deflation.dailySnapshot(ethers.parseEther("100"));
      const day1 = BigInt(Math.floor((await ethers.provider.getBlock("latest")).timestamp / 86400));

      // 第 2 天构造出局（staticExitMul 置 0）
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      await config.setUint("staticExitMul", 0);
      await mining.connect(alice).convertPowerToZyt(1n);
      expect((await mining.userInfo(alice.address))[6]).to.equal(true); // isExited
      await config.setUint("staticExitMul", 2);

      // 第 3 天提取：第 1 天的分红仍可结算（出局不清算历史算力）
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      expect((await mining.userInfo(alice.address))[4]).to.equal(0n); // 出局后当前算力为 0
      const before = await zyt.balanceOf(alice.address);
      await mining.connect(alice).claimDividend();
      const got = (await zyt.balanceOf(alice.address)) - before;
      expect(got).to.equal((await mining.dailyInfo(day1))[2]); // 唯一算力 → 全额
    });

    it("复投前须结清历史分红（防 powerDay 更新后历史算力无法回算）", async function () {
      const { mining, deflation, usdt, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("300"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await deflation.dailySnapshot(ethers.parseEther("100")); // 该日产生分红
      // 快进 400 天（超过单次结算上限 365 天）后再复投
      await ethers.provider.send("evm_increaseTime", [400 * 86400]);
      await ethers.provider.send("evm_mine", []);
      await expect(mining.connect(alice).deposit(ethers.parseEther("100"), ZERO)).to.be.revertedWith(
        "Mining: settle dividend first"
      );
      // 先提取（单次最多结算 365 天，游标推进到覆盖今日），复投即恢复
      await mining.connect(alice).claimDividend();
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      const info = await mining.userInfo(alice.address);
      expect(info[0]).to.equal(ethers.parseEther("200")); // depositTotal 累加
      expect(info[4]).to.be.gt(ethers.parseEther("100")); // 历史算力已复利固化，未丢失
    });
  });

  describe("安全修复 V4-V7（审计第二批）", function () {
    it("V4：非 keeper/owner 调用 dailySnapshot 被拒（防恶意 totalPower）", async function () {
      const { deflation, config, alice } = await deployFixture();
      // fixture 中 keeperAddress = deployer（owner）；alice 非 keeper 非 owner
      expect(await config.keeperAddress()).to.equal((await ethers.getSigners())[0].address);
      await expect(deflation.connect(alice).dailySnapshot(ethers.parseEther("1000000000"))).to.be.revertedWith("Deflation: not keeper");
    });

    it("V4：owner 可触发快照（多签兜底）", async function () {
      const { deflation } = await deployFixture();
      await deflation.dailySnapshot(0); // deployer = owner
    });

    it("V5：初始底池 2.1 万 USDT 真实转入池（账面=实际）", async function () {
      const { pool, usdt } = await deployFixture();
      // 池实际 USDT 余额 = 初始 2.1 万（fixture 未入金）
      expect(await usdt.balanceOf(await pool.getAddress())).to.equal(GST_POOL);
      expect(await pool.poolUSDT()).to.equal(GST_POOL);
    });

    it("V5：卖出后账面与实际一致（实际余额 ≥ 账面 2.1 万缺口消除）", async function () {
      const { mining, usdt, zyt, pool, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // 入金 60U 进池：实际 = 21000 + 60，账面 = 21000 + 60 → 一致
      expect(await usdt.balanceOf(await pool.getAddress())).to.equal(GST_POOL + ethers.parseEther("60"));
      expect(await pool.poolUSDT()).to.equal(GST_POOL + ethers.parseEther("60"));
    });

    it("V3：推荐循环绑定被拒（A→B→A 防自我奖励）", async function () {
      const { mining, referral, usdt, alice, bob } = await deployFixture();
      // A(先入金成为上级) → B 带 A 推荐
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // A 再入金时尝试绑定到 B 形成循环？实际 bind(A) 已绑定，bind(B,A) 先：
      await fundUsdt(usdt, bob, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(bob).deposit(ethers.parseEther("100"), alice.address); // B → A
      // A 尝试把上级链引向 B（A 已绑定谁？首次入金 ref=0 → 未绑定）：
      // A 首次 deposit ref=ZERO → referrerOf[A]=0；此时让 A 用 B 作 ref 再入金 → bind(A,B)
      // 但 bind(A,B) 检查 B 祖先链是否含 A：B 的上级是 A → 含 A → 应拒绝
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), bob.address); // 尝试 A→B（循环）
      // A 的 referrer 应仍为 0（绑定被拒）
      expect(await referral.referrerOf(alice.address)).to.equal(ZERO);
    });

    it("V6：用户间转账扣 10% 滑点（转账视同卖出）", async function () {
      const { mining, usdt, zyt, alice, bob } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("100")); // 兑换得 ZYT
      const bal = await zyt.balanceOf(alice.address);
      const amount = ethers.parseEther("1000");
      await zyt.connect(alice).transfer(bob.address, amount);
      // 转出 1000 + 10% 滑点 100 销毁 = 1100
      expect(await zyt.balanceOf(alice.address)).to.equal(bal - amount - amount / 10n);
      expect(await zyt.balanceOf(bob.address)).to.equal(amount);
    });

    it("V7：mintTo 超过 totalSupplyCap 被拒（防无限增发）", async function () {
      const { mining, usdt, config, zyt, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // 入金完成后再压 cap（入金本身会经 Creator 铸币，若先压 cap 会在 deposit 处回滚）
      await config.setUint("totalSupplyCap", (await zyt.totalSupply()) + 1n);
      // 兑换路径触发 mintTo → 超 cap 应 revert
      await expect(mining.connect(alice).convertPowerToZyt(ethers.parseEther("100")))
        .to.be.revertedWith("ZYT: supply cap");
    });
  });

  describe("安全修复 V8-V13（审计 P2）", function () {
    it("V9：销毁后 soldAmount 不扣减（进度不被侵蚀）", async function () {
      const { mining, usdt, zyt, forceSell, alice, bob } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("100")); // 兑换得 ZYT
      // 快进 15 天（进入窗口 1）
      await ethers.provider.send("evm_increaseTime", [FIFTEEN_DAYS]);
      await ethers.provider.send("evm_mine", []);
      await zyt.connect(alice).transfer(bob.address, 1n); // 触发 checkAndBurn：soldAmount=1，销毁 1
      // 修复后：soldAmount 保持 1（销毁不扣减）
      expect(await forceSell.soldAmount(alice.address)).to.equal(1n);
    });

    it("V8：settleExpired 到期自动销毁差额（owner 触发）", async function () {
      const { mining, usdt, zyt, forceSell, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("100")); // 兑换得 ZYT
      const bal = await zyt.balanceOf(alice.address);
      // 快进 15 天
      await ethers.provider.send("evm_increaseTime", [FIFTEEN_DAYS]);
      await ethers.provider.send("evm_mine", []);
      // owner 调用 settleExpired → 销毁 余额×20% 差额（alice 未卖出）
      await forceSell.settleExpired(alice.address);
      const expectedBurn = (bal * 20n) / 100n;
      expect(await zyt.balanceOf(alice.address)).to.equal(bal - expectedBurn);
      // 事件已发（余额验证等价，跳过事件断言）
    });

    it("P1-13：settleExpired 同窗口重复调用不再销毁（防 Keeper 递归抽水）", async function () {
      const { mining, usdt, zyt, forceSell, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("100"));
      const bal = await zyt.balanceOf(alice.address);

      await ethers.provider.send("evm_increaseTime", [FIFTEEN_DAYS]);
      await ethers.provider.send("evm_mine", []);

      // 首次结算：烧掉余额的 20%，窗口 1 位图置位
      const burn1 = (bal * 20n) / 100n;
      await forceSell.settleExpired(alice.address);
      const afterFirst = bal - burn1;
      expect(await zyt.balanceOf(alice.address)).to.equal(afterFirst);
      expect(await forceSell.settledWindows(alice.address)).to.equal(1n);

      // 同窗口重复调用：余额必须保持不变（修复前会继续烧 20% / 16% / 12.8% ...）
      await forceSell.settleExpired(alice.address);
      expect(await zyt.balanceOf(alice.address)).to.equal(afterFirst);
      await forceSell.settleExpired(alice.address);
      expect(await zyt.balanceOf(alice.address)).to.equal(afterFirst);

      // 进入窗口 2 后可再次结算，累计目标 30%，位图变为 bit0|bit1
      await ethers.provider.send("evm_increaseTime", [FIFTEEN_DAYS]);
      await ethers.provider.send("evm_mine", []);
      await forceSell.settleExpired(alice.address);
      expect(await forceSell.settledWindows(alice.address)).to.equal(3n);
      const burn2 = (afterFirst * 30n) / 100n;
      expect(await zyt.balanceOf(alice.address)).to.equal(afterFirst - burn2);
    });

    it("V8：settleExpired 非 keeper/owner 被拒", async function () {
      const { forceSell, alice } = await deployFixture();
      await expect(forceSell.connect(alice).settleExpired(alice.address)).to.be.revertedWith("FS: not keeper");
    });

    it("V10：setUint 费率参数超过 10000 被拒", async function () {
      const { config } = await deployFixture();
      await expect(config.setUint("baseSlippage", 20000)).to.be.revertedWith("ZYTConfig: rate > 10000");
      await expect(config.setUint("slippageTier4", 10001)).to.be.revertedWith("ZYTConfig: rate > 10000");
      // 正常值仍可设置
      await config.setUint("baseSlippage", 800);
      expect(await config.baseSlippage()).to.equal(800);
    });

    it("V13：claimDividend 重复调用不重复发币（按日结算游标推进）", async function () {
      const { mining, pool, deflation, usdt, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await deflation.dailySnapshot(ethers.parseEther("100")); // 产生分红
      expect(await pool.dividendPool()).to.be.gt(0n);
      // 次日提取
      await ethers.provider.send("evm_increaseTime", [DAY]);
      await ethers.provider.send("evm_mine", []);
      await mining.connect(alice).claimDividend();
      expect((await mining.dividendOf(alice.address))[0]).to.equal(0n); // 待提已清空
      // 同日再次调用：无新的已结束日可结算，待提为 0
      await expect(mining.connect(alice).claimDividend()).to.be.revertedWith("Mining: nothing to claim");
    });
  });

  describe("安全修复 V14/V17（审计 P3）", function () {
    it("V14：锁定后非豁免转账被拒，豁免 flag 可设置", async function () {
      const { gst, pool, alice, bob } = await deployFixture();
      // 锁定后（fixture 已 lockRemaining）：普通地址转账被拒（require 先于余额检查）
      await expect(gst.connect(alice).transfer(bob.address, ethers.parseEther("1"))).to.be.revertedWith("GST: supply locked");
      // 豁免机制存在：pool 可被设为豁免（前瞻 DEX 接入）
      await gst.setTransferAllowed(await pool.getAddress(), true);
      expect(await gst.transferAllowed(await pool.getAddress())).to.equal(true);
    });

    it("V17：Sold 事件携带滑点档位（rate）", async function () {
      const { mining, usdt, zyt, pool, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60")); // 兑换得 ZYT
      const zytOfAlice = await zyt.balanceOf(alice.address);
      await zyt.connect(alice).approve(await pool.getAddress(), ethers.MaxUint256);
      const sellAmt = zytOfAlice / 10n;
      const tx = await mining.connect(alice).sellZyt(sellAmt);
      const receipt = await tx.wait();
      const sold = receipt.logs
        .map((l) => {
          try {
            return mining.interface.parseLog(l);
          } catch {
            return null;
          }
        })
        .filter((x) => x && x.name === "Sold");
      expect(sold.length).to.equal(1);
      expect(sold[0].args.rate).to.equal(500n); // 基准滑点 5% = 500 基点
      expect(sold[0].args.zytIn).to.equal(sellAmt);
    });
  });

  describe("第二轮深度检测修复（P1-1/P1-2）", function () {
    it("产出停用：claimReward 一律 revert，全网算力仍照常记录（分红分母）", async function () {
      const { mining, deflation, usdt, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      // 每日快照仍记录全网算力，分红（claimDividend）依赖该值作分母
      await deflation.dailySnapshot(ethers.parseEther("100"));
      const day = BigInt(Math.floor((await ethers.provider.getBlock("latest")).timestamp / 86400));

      // 产出停用：不再新增 ZYT 供应
      expect(await mining.dailyReleaseAmount()).to.equal(0n);
      const info = await mining.dailyInfo(day);
      expect(info[0]).to.equal(ethers.parseEther("100")); // totalPower 照常记录
      expect(info[1]).to.equal(0n); // releaseAmount 恒为 0

      await expect(mining.connect(alice).claimReward(day)).to.be.revertedWith("Mining: reward disabled");
      // 任意 day 参数同样被拒（函数体已停用，不做日期校验）
      await expect(mining.connect(alice).claimReward(0)).to.be.revertedWith("Mining: reward disabled");
    });

    it("P1-2：推荐奖励改为 USDT 直发（额度机制已取消）", async function () {
      const { mining, usdt, alice, bob } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      const usdtA0 = await usdt.balanceOf(alice.address);

      // bob 连续 5 次入金 500U 且 ref=alice → alice 每次拿 7% = 35U，累计 175U
      await fundUsdt(usdt, bob, ethers.parseEther("2500"), await mining.getAddress());
      for (let i = 0; i < 5; i++) {
        await mining.connect(bob).deposit(ethers.parseEther("500"), alice.address);
      }
      expect(await usdt.balanceOf(alice.address)).to.equal(usdtA0 + ethers.parseEther("175"));
    });

    it("P1-3：静态出局用户复投自动重置出局状态（决策 A）", async function () {
      const { mining, config, usdt, zyt, pool, deflation, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("300"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);

      // 临时调 staticExitMul=0 构造出局（withdrawTotal >= depositTotal×0 恒真），兑换 1 wei 即触发
      await config.setUint("staticExitMul", 0);
      await mining.connect(alice).convertPowerToZyt(1n);
      expect((await mining.userInfo(alice.address))[6]).to.equal(true); // isExited=true

      // 调回 2 倍后复投 → 出局状态重置（withdrawTotal 保留不清零）
      await config.setUint("staticExitMul", 2);
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      expect((await mining.userInfo(alice.address))[6]).to.equal(false); // 复投后重置

      // 复投后算力恢复且未出局（产出已停用，此处只断言状态）
      const info = await mining.userInfo(alice.address);
      expect(info[4]).to.be.gt(0n); // power > 0
      expect(info[6]).to.equal(false); // 未出局
    });

    it("P2-2：营销/技术地址白名单豁免强制卖出初始化（决策 A 保护）", async function () {
      const { mining, usdt, zyt, pool, forceSell, deployer, alice } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("100"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("100"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("60")); // 兑换得 ZYT
      // 卖出 → 滑点 30% 营销转给 marketAddress=deployer（白名单）→ 不应启动强制卖出窗口
      const bal = await zyt.balanceOf(alice.address);
      expect(bal).to.be.gt(0n);
      await zyt.connect(alice).approve(await pool.getAddress(), ethers.MaxUint256);
      await mining.connect(alice).sellZyt(bal);
      expect(await forceSell.initialized(deployer.address)).to.equal(false);
      expect(await forceSell.firstReceiveTime(deployer.address)).to.equal(0n);
    });

    it("P1-7：转账按快照价双向记账，提取额度随币转移（额度守恒）", async function () {
      const { mining, pool, usdt, zyt, alice, bob } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("500"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("500"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("400"));
      const bal = await zyt.balanceOf(alice.address);
      const price = await pool.getTradePrice();

      // 转账前：alice 提取额 = 兑换额；bob 无任何额度
      expect((await mining.userInfo(alice.address))[1]).to.equal(ethers.parseEther("400"));
      let tv = await mining.transferValueOf(bob.address);
      expect(tv[0]).to.equal(0n);
      expect(tv[1]).to.equal(0n);

      // 转出 80% 余额（留 20% 覆盖 10% 转账税）
      const amount = (bal * 80n) / 100n;
      const expectUsdt = (amount * price) / 10n ** 18n;
      expect(expectUsdt).to.be.gt(0n);
      await zyt.connect(alice).transfer(bob.address, amount);

      // 转出方：提取额按快照价折算递增（转账视同提取）
      expect((await mining.userInfo(alice.address))[1]).to.equal(ethers.parseEther("400") + expectUsdt);
      // 接收方：受赠额度建立，提取上限 = 入金×2 + 受赠 = 受赠（bob 零入金）
      tv = await mining.transferValueOf(bob.address);
      expect(tv[0]).to.equal(expectUsdt);
      expect(tv[1]).to.equal(expectUsdt);
    });

    it("P1-8：零入金地址收到币后受静态出局约束（不再永久绕过）", async function () {
      const { mining, pool, usdt, zyt, deflation, alice, bob, deployer } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("500"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("500"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("400"));
      const bal = await zyt.balanceOf(alice.address);

      // 转给零入金地址 bob（depositTotal 恒为 0）
      await zyt.connect(alice).transfer(bob.address, (bal * 80n) / 100n);
      expect((await mining.userInfo(bob.address))[0]).to.equal(0n); // 确认 bob 零入金
      const tv = await mining.transferValueOf(bob.address);
      expect(tv[0]).to.be.gt(0n);
      expect(tv[1]).to.equal(tv[0]); // 上限 = 受赠值

      // 推高池 USDT（6 次 500U 入金）抬升快照价，使卖出折算值超过受赠上限
      for (let i = 0; i < 6; i++) {
        await fundUsdt(usdt, deployer, ethers.parseEther("500"), await mining.getAddress());
        await mining.connect(deployer).deposit(ethers.parseEther("500"), ZERO);
      }
      await deflation.dailySnapshot(0);

      const bobBal = await zyt.balanceOf(bob.address);
      await zyt.connect(bob).approve(await pool.getAddress(), ethers.MaxUint256);
      await mining.connect(bob).sellZyt(bobBal);

      // 提取额越过受赠上限 → 出局（旧逻辑下 depositTotal==0 早退，恒不出局）
      expect((await mining.userInfo(bob.address))[6]).to.equal(true);
    });

    it("P1-9：强制卖出应卖量以转账前余额为基数（大额转出不放水）", async function () {
      const { mining, usdt, zyt, alice, bob } = await deployFixture();
      await fundUsdt(usdt, alice, ethers.parseEther("500"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("500"), ZERO);
      await mining.connect(alice).convertPowerToZyt(ethers.parseEther("400"));
      const bal = await zyt.balanceOf(alice.address);

      // 快进 15 天：进入第 1 个窗口（累计应卖 20%）
      await ethers.provider.send("evm_increaseTime", [15 * 86400 + 1]);
      await ethers.provider.send("evm_mine", []);

      // 转出 18% 余额：修复后门槛 = 转账前余额 × 20% > 18%，不足 2% → 触发销毁
      // 若按转账后余额（82%）算，门槛仅 16.4%，18% 已达标，不会销毁
      const amount = (bal * 18n) / 100n;
      const before = await zyt.balanceOf(alice.address);
      await zyt.connect(alice).transfer(bob.address, amount);
      const delta = before - (await zyt.balanceOf(alice.address));
      const tax = (amount * 10n) / 100n; // 双非白名单转账税 10%
      expect(delta).to.be.gt(amount + tax);
    });

    it("P1-11：储备池的 GST 只能流向 Creator（1:1 释放强制化）", async function () {
      const { gst, creator, deployer, alice } = await deployFixture();
      const creatorAddr = await creator.getAddress();
      expect(await gst.reserve()).to.equal(deployer.address);
      expect(await gst.creator()).to.equal(creatorAddr);
      expect(await gst.balanceOf(deployer.address)).to.be.gt(0n); // 储备池持有全量剩余 GST

      // 1. 储备池 → 白名单地址：被拒（白名单不再是储备池的出口）
      await gst.setTransferAllowed(alice.address, true);
      await expect(gst.connect(deployer).transfer(alice.address, 1n)).to.be.revertedWith(
        "GST: reserve outflow restricted"
      );

      // 2. 储备池 → Creator：放行（唯一出口，按入金量取用）
      const before = await gst.balanceOf(creatorAddr);
      await gst.connect(deployer).transfer(creatorAddr, 100n);
      expect(await gst.balanceOf(creatorAddr)).to.equal(before + 100n);

      // 3. 储备池 → 黑洞：恒放行（Creator 兑换 ZYT 时的退出流通路径）
      await gst.connect(deployer).transfer(await gst.blackHole(), 100n);
    });

    it("P1-12：追加入金固化已累积复利，不清零老算力", async function () {
      const { mining, usdt, alice } = await deployFixture();
      /** 与合约 ZYTCompute.powerWithCompound 同口径：日复利 1%，整数运算 */
      const compound = (base, days) => {
        let p = base;
        for (let i = 0; i < days; i++) p = p + (p * 100n) / 10000n;
        return p;
      };

      await fundUsdt(usdt, alice, ethers.parseEther("1000"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("500"), ZERO);

      // 快进 30 天：算力按日复利增长
      await ethers.provider.send("evm_increaseTime", [30 * 86400]);
      await ethers.provider.send("evm_mine", []);
      const power30 = compound(ethers.parseEther("500"), 30);
      expect((await mining.userInfo(alice.address))[4]).to.equal(power30);

      // 追加入金 500U
      await fundUsdt(usdt, alice, ethers.parseEther("500"), await mining.getAddress());
      await mining.connect(alice).deposit(ethers.parseEther("500"), ZERO);

      // 修复后：老算力固化到今日（power30）再加新算力 500
      // 修复前：powerBase 直接变为 1000，此前 30 天复利全部丢失
      const after = (await mining.userInfo(alice.address))[4];
      expect(after).to.equal(power30 + ethers.parseEther("500"));
      expect(after).to.be.gt(ethers.parseEther("1000"));
    });

    it("P1-7/P1-8：isStaticExited 边界（受赠计入上限，零入金不早退）", async function () {
      const { compute } = await deployFixture();
      // 零入金 + 零受赠：无任何额度来源，不判出局
      expect(await compute.isStaticExited(0n, 0n, 2n, 0n)).to.equal(false);
      expect(await compute.isStaticExited(1000n, 0n, 2n, 0n)).to.equal(false);
      // 零入金 + 有受赠：上限即受赠值
      expect(await compute.isStaticExited(99n, 0n, 2n, 100n)).to.equal(false);
      expect(await compute.isStaticExited(100n, 0n, 2n, 100n)).to.equal(true);
      // 有入金 + 有受赠：上限 = 入金 × 倍数 + 受赠
      expect(await compute.isStaticExited(299n, 100n, 2n, 100n)).to.equal(false);
      expect(await compute.isStaticExited(300n, 100n, 2n, 100n)).to.equal(true);
      // 出局倍数置 0（P1-3 构造用例）：不得早退，任何提取即到顶
      expect(await compute.isStaticExited(1n, 100n, 0n, 0n)).to.equal(true);
    });
  });
});
