# ===== 众赢币 ZYT 合约部署配置 =====
# 复制为 .env 后填写真实值，切勿提交到仓库（已 .gitignore）

# ===== 部署私钥（仅存本地/部署机，严禁上传服务器、严禁提交 Git） =====
# testnet：当前测试私钥；主网部署时替换为主网 deployer 私钥（用后建议换新）
# 主网部署有交互确认（输入 yes），防误操作；脚本化场景设 CONFIRM_MAINNET=1
PRIVATE_KEY=

# RPC（可选，缺省用官方公共节点）
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org

# BscScan API Key（合约 verify 用）
BSCSCAN_API_KEY=YWJZSDRM71NRB94A5SJW9SBWCJHCP9YPNY

# ===== Router / USDT（按网络分流，deploy.js v16 自动选择） =====
# 主网（network=bsc）
USDT_MAINNET=0x55d398326f99059fF775485246999027B3197955
ROUTER_MAINNET=0x10ED43C718714eb63d5aA57B78B54704E256024E
# 测试网（network=bscTestnet；官方 USDT 无 mint，测试部署必须 USDT_MOCK=1 用 MockERC20）
USDT_TESTNET=0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
ROUTER_TESTNET=0x9Ac64Cc6e4415144C455BD8E4837Fea55603e5c3

# ===== 地址（mainnet 部署前必须确认） =====
# 黑洞地址
BLACK_HOLE=0x000000000000000000000000000000000000dEaD
# 营销地址（v16 单钱包方案：上线前填治理钱包；testnet 用 deployer 兜底）
MARKET_ADDRESS=0x1bc03Fe18F9BabBc32f0B4046E13e387E9D16786
# 技术运维地址（v16 单钱包方案：同上）
TECHNICAL_ADDRESS=0x860D4704d6eee98Aa55A971Caf8BAA4134E8eec3


KEEPER_ADDRESS=0x09BeD12b5956E1E53668Aa10E242766E3aE3B641
# 运营首批买入白名单（逗号分隔；留空则后续由 owner 调 setBuyWhitelistBatch 添加）
WHITELIST=

