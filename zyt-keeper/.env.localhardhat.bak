INDEXER_POLL_MS=30000
START_BLOCK=0
BLOCK_RANGE=1000

API_PORT=8080
# 存储层：:memory:（本地联调）或 mysql://user:pass@host:port/db（生产/testnet）
# 本地 MySQL：root/123456，已建 zyt_keeper 库 + zyt_keeper 用户
