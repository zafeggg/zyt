# ===== 众赢币 ZYT 链下服务配置 =====
# 复制为 .env 后填写

# 链与 RPC（默认本地 hardhat；testnet 参考值见下方注释块）
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# 合约地址（默认本地 hardhat 部署地址，testnet/mainnet 部署后替换）
MINING_ADDR=0x2279B7A0a67DB372996a5FaB50D91eAA73d2eBe6
POOL_ADDR=0x5FC8d32690cc91D4c39d9d3abcBD16989F875707
DEFLATION_ADDR=0x8A791620dd6260079BF849Dc5567aDC3F2FdC318
CONFIG_ADDR=0xe7f1725E7734CE288F8367e1Bb143E90bb3F0512
ZYT_ADDR=0xCf7Ed3AccA5a467e9e704C703E8D87F634fB0Fc9
# 强制卖出合约（#7 追踪数据源；留空则禁用追踪）
FORCESELL_ADDR=0x0000000000000000000000000000000000000000

# ===== 第六套 BSC testnet 参考值（2026-09-09，决策 21；生产 .env 直接替换上面四段即可） =====
# CHAIN_ID=97
# RPC_URL=https://bsc-testnet-rpc.publicnode.com
# MINING_ADDR=0x1ffCec692Ef2c8287C1dE7248B0621bdAd135703
# POOL_ADDR=0x020927BC660f7631709d388C992979359196DcfD
# DEFLATION_ADDR=0x16E8A145D015D80892e5CFe8cE305F0717F229a9
# CONFIG_ADDR=0x55F4e5F732ACfa49015AB6546a2766Db7534cDbd
# ZYT_ADDR=0xdF18105bB57165c59AD651Eda1B4d896412d4166
# FORCESELL_ADDR=0x24685AF81fc8443ED46b11Cb17Ba7af0ae55ce06
# START_BLOCK=129938500（部署前块，回拨重放；久停后按公共 RPC prune 窗口推至最新块）

# Keeper：每日 08:00 北京时间快照（UTC 0 点 cron，不依赖服务器时区）
SNAPSHOT_CRON=0 0 * * *
RETRY_TIMES=3
RETRY_DELAY_MS=30000
# 签名钱包私钥（生产必填）：仅用于触发每日快照写交易，地址不持有资金、合约不授权资金操作
# 安全：私钥只存服务器环境变量/密钥管理服务，禁止提交到代码库
KEEPER_PRIVATE_KEY=
# 双实例互斥锁：生产多实例部署必须配 Redis（SETNX 原子锁防重复触发快照）
# 未配置时降级为本地文件锁（仅单机场景有效）
REDIS_URL=
# 锁 TTL 毫秒（进程崩溃兜底；默认 10 分钟覆盖 08:00-08:10 重试窗）
KEEPER_LOCK_TTL_MS=600000

# 索引轮询
INDEXER_POLL_MS=30000
START_BLOCK=0
BLOCK_RANGE=1000

# 强制卖出追踪（#7）
FORCESELL_ENABLED=true
FORCESELL_SYNC_MS=600000   # 同步间隔 10min
FORCESELL_ALERT_COOLDOWN_MS=3600000 # 每用户预警冷却 1h

# 监控规则引擎（可选开关；阈值均可调）
MONITOR_ENABLED=true
MONITOR_INTERVAL_MS=30000   # 周期检查间隔
MONITOR_POOL_DROP_PCT=10    # R1 底池突变阈值 %
MONITOR_BIG_SELL_PCT=5      # R2 大额卖出阈值 %
MONITOR_INDEX_LAG_BLOCKS=120 # R4 索引延迟块数（BSC 3s/块 ≈ 6min）
MONITOR_ERROR_RATE_PCT=30   # R5 调用失败率阈值 %
MONITOR_ERROR_WINDOW_SEC=600 # R5 统计窗口
MONITOR_COOLDOWN_MS=600000  # 规则告警冷却（防风暴）

# API（生产加固 #6）
API_PORT=8080
# 管理端点（/reconcile）鉴权 token：生产必填；留空则端点禁用（403）
API_ADMIN_TOKEN=
# 全局限流：每 IP 每分钟请求数（/health 豁免）
API_RATE_LIMIT=100
# CORS 允许来源：* = 全放行（前端同域部署默认）；分离部署配具体域名，逗号分隔多域名
# 例：CORS_ORIGIN=https://zyt.example.com,https://m.zyt.example.com
CORS_ORIGIN=*

# 数据库
DB_PATH=./data/zyt.db

# 告警（可选：TG bot webhook 或任意 POST 接口）
ALERT_WEBHOOK_URL=
