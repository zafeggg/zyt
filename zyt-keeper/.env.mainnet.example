# 众赢币 ZYT Keeper —— 主网 TestUSDT 试运行版配置（2026-09-14）
# 启动方式：ENV_FILE=.env.mainnet node src/index.js
# 与 testnet 配置（.env）并存，通过 ENV_FILE 切换；主网用独立 DB 库 zyt_keeper_mainnet

# ===== 链与 RPC =====
CHAIN_ID=56
# publicnode 主网：getLogs 支持（实测 1000 块范围可用）；注意归档请求（老块状态）需 token
RPC_URL=https://bsc-rpc.publicnode.com
# 备用：https://bsc.publicnode.com（同族）；官方 seed 的 getLogs 受限，blockrazor 限 25 块

# ===== 合约地址（主网 TestUSDT 试运行版，deployments/mainnet-test-20260914.json）=====
MINING_ADDR=0xFC97Bf17243C2ef9A8442c190A1897B61745C830
POOL_ADDR=0xe2b0DdB48f4455830D38cD765d9b79DBd906c291
DEFLATION_ADDR=0x95e60944e0DF1846f5498B4b8A678564f9aCDe26
CONFIG_ADDR=0x7247791Bd79e831C78B8DCFDF820C43a7386f370
ZYT_ADDR=0xAB4c090CD436D1d93Aa6D18067A3217206Bd097A
FORCESELL_ADDR=0xD944f0A514b92F9adBc805F7E94E75aD489Af2A6

# ===== keeper 签名钱包（0x09BeD12b5956E1E53668Aa10E242766E3aE3B641）=====
# ⚠️ 待填：主网 keeper 钱包私钥（仅本地持有，严禁提交 Git、严禁上传服务器）
# 该地址已接线：ZYTConfig.keeperAddress + ZYTForceSell.keeper
KEEPER_PRIVATE_KEY=

# ===== 索引起点（部署块前 1000 块，回拨重放；久停后按 RPC prune 窗口推至最新块）=====
START_BLOCK=121785500

# ===== 数据库（主网独立库，与 testnet 数据隔离）=====
DB_URL=mysql://zyt_keeper:zyt_keeper_pass@127.0.0.1:3306/zyt_keeper_mainnet

# ===== API（与 testnet keeper 8080 并存时用 8081）=====
API_PORT=8081

# ===== 快照时区（北京 08:00 = UTC 00:00）=====
SNAPSHOT_CRON=0 0 * * *
SNAPSHOT_CRON_TZ=UTC

# ===== 轮询与重试 =====
INDEXER_POLL_MS=30000
BLOCK_RANGE=1000
RETRY_TIMES=3
RETRY_DELAY_MS=30000
